# Reown Cloud project ID — get one at https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Ethereum mainnet RPC — Alchemy app URL
# https://eth-mainnet.g.alchemy.com/v2/<KEY>
NEXT_PUBLIC_RPC_URL=

# Optional per-network RPCs for balance reads (Base / Arbitrum / Polygon).
# If left blank, public fallback endpoints are used (lower reliability).
NEXT_PUBLIC_RPC_URL_BASE=
NEXT_PUBLIC_RPC_URL_ARBITRUM=
NEXT_PUBLIC_RPC_URL_POLYGON=

# Alchemy key for the server-side eligibility read (every priced token a wallet
# holds, via the Portfolio Data API). Server-only — never exposed to the client.
# If blank, the key embedded in an Alchemy RPC URL above is reused.
ALCHEMY_API_KEY=
# Networks scanned for the eligible balance (comma-separated Alchemy network ids).
# Default: eth-mainnet,polygon-mainnet
ELIGIBILITY_NETWORKS=

# Session JWT signing — generate with: openssl rand -hex 32
SESSION_SECRET=

# Nonce cookie signing — generate with: openssl rand -hex 32 (DIFFERENT from SESSION_SECRET)
NONCE_SECRET=

# Session TTL (seconds). Default = 7 days.
SESSION_TTL_SECONDS=604800

# --- Card vault (Polygon mainnet) ---
# ERC-4626 vault address on Polygon
NEXT_PUBLIC_VAULT_ADDRESS=
# Collateral token. Defaults to native Circle USDC (0x3c49…3359) if blank.
# Set to bridged USDC.e (0x2791…4174) only if the vault uses it.
NEXT_PUBLIC_USDC_ADDRESS=
# EIP-2612 permit domain version: "2" for native USDC, "1" for bridged USDC.e
NEXT_PUBLIC_USDC_PERMIT_VERSION=2

# --- Admin persistence (Prisma + Postgres) ---
# Postgres connection string for Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/auracard?schema=public"
# Admin session signing secret (>= 32 chars)
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Optional: admin session lifetime in seconds (default 86400 = 1 day)
ADMIN_SESSION_TTL_SECONDS="86400"
# Used only by `npm run seed:admin`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="a-strong-password"

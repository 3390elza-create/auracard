# Copy to `.env` on the VPS and fill in. NEVER commit the filled-in .env.

# --- Domain (Caddy / HTTPS) ---
# The bare domain you pointed at this server's IP (no http://, no trailing slash).
DOMAIN=example.com

# --- Build-time PUBLIC vars (baked into the client bundle at `docker compose build`) ---
# Required for the build to succeed (zod-validated):
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_RPC_URL=https://eth.llamarpc.com

# Polygon RPC — REQUIRED. The card vault lives on Polygon; balances + deposit
# read through this. Use a working Alchemy URL (https://polygon-mainnet.g.alchemy.com/v2/<KEY>).
NEXT_PUBLIC_RPC_URL_POLYGON=
# Optional extra networks (public fallbacks used if blank):
NEXT_PUBLIC_RPC_URL_BASE=
NEXT_PUBLIC_RPC_URL_ARBITRUM=

# --- Card vault (Polygon mainnet) ---
NEXT_PUBLIC_VAULT_ADDRESS=0xD5bc33Df93749070548cCab147916eB12FeCe5FB
# Collateral token: blank = native Circle USDC (0x3c49…3359), the vault asset.
NEXT_PUBLIC_USDC_ADDRESS=
# EIP-2612 permit version: 2 = native USDC, 1 = bridged USDC.e
NEXT_PUBLIC_USDC_PERMIT_VERSION=2

# --- Cross-chain zap (LI.FI) — Plan 4, not consumed until the zap UI is wired ---
# Build-time (baked into the client bundle). Optimism is a zap source chain.
NEXT_PUBLIC_RPC_URL_OPTIMISM=
# Integrator id (any string identifying this app). https://portal.li.fi for an API key.
NEXT_PUBLIC_LIFI_INTEGRATOR=aura-card
# Runtime, server-only. Optional — raises LI.FI rate limits.
LIFI_API_KEY=

# --- Eligibility (read every priced token a wallet holds, server-side) ---
# Alchemy key for the Portfolio Data API. Blank = reuse the key from the Polygon
# URL above. Server-only — never exposed to the client.
ALCHEMY_API_KEY=
# Networks scanned (default: eth-mainnet,polygon-mainnet)
ELIGIBILITY_NETWORKS=eth-mainnet,polygon-mainnet

# --- Runtime server SECRETS (generate fresh for production) ---
# openssl rand -hex 32   (use DIFFERENT values)
SESSION_SECRET=
NONCE_SECRET=
SESSION_TTL_SECONDS=604800

# --- Admin dashboard (Prisma + Postgres) ---
# Postgres credentials for the bundled `db` service:
POSTGRES_USER=aura
POSTGRES_PASSWORD=
POSTGRES_DB=auracard
# Must match the credentials above; host is the compose service name `db`.
DATABASE_URL=postgresql://aura:CHANGE_ME@db:5432/auracard?schema=public
# Admin session signing secret (>= 32 chars; openssl rand -hex 32)
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=86400

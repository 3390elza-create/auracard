# Copy to `.env` on the VPS and fill in. NEVER commit the filled-in .env.

# --- Domain (Caddy / HTTPS) ---
# The bare domain you pointed at this server's IP (no http://, no trailing slash).
DOMAIN=example.com

# --- Build-time PUBLIC vars (baked into the client bundle at `docker compose build`) ---
# Required for the build to succeed (zod-validated):
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_RPC_URL=

# Optional per-network RPCs (public fallbacks used if blank):
NEXT_PUBLIC_RPC_URL_BASE=
NEXT_PUBLIC_RPC_URL_ARBITRUM=
NEXT_PUBLIC_RPC_URL_POLYGON=
NEXT_PUBLIC_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org

# Vault contract addresses (leave blank until deployed; card panel stays inactive):
NEXT_PUBLIC_TEST_USDC_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=

# --- Runtime server SECRETS (generate fresh for production) ---
# openssl rand -hex 32   (use two DIFFERENT values)
SESSION_SECRET=
NONCE_SECRET=
SESSION_TTL_SECONDS=604800
